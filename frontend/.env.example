# SpaceGuard AI — Frontend Environment Variables
# Copy to .env for local development. Values are optional in dev mode
# (Vite proxy handles API routing in development).

# Backend API URL — leave empty for dev (uses Vite proxy), set for production
VITE_API_URL=https://spaceguard-ai-exploration.onrender.com

# Socket.IO URL — leave empty for dev (uses Vite proxy), set for production
VITE_SOCKET_URL=https://spaceguard-ai-exploration.onrender.com
